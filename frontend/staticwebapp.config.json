{
  "routes": [
    {
      "route": "/contracts*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/ContractsLogExport*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/RagSetupForm*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/.auth/*"]
  }
}
