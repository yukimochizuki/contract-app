{
  "@odata.context": "${search_endpoint}/$metadata#skillsets/$entity",
  "name": "${contractid}-skillset",
  "description": "Skillset to chunk documents and generate embeddings",
  "skills": [
    {
      "@odata.type": "#Microsoft.Skills.Custom.WebApiSkill",
      "name": "#text-1",
      "description": "A custom web skill.",
      "context": "/document",
      "uri": "${customskill_endpoint}/split",
      "timeout": "PT230S",
      "batchSize": 1,
      "authResourceId": "api://${customskill_appid}",
      "inputs": [
        {
          "name": "content",
          "source": "/document/content"
        },
        {
          "name": "file_data",
          "source": "/document/file_data"
        },
        {
          "name": "image_data",
          "source": "/document/normalized_images"
        },
        {
          "name": "metadata_storage_path",
          "source": "/document/metadata_storage_path"
        },
        {
          "name": "recordid",
          "source": "/document/recordid"
        },
        {
          "name": "displayname",
          "source": "/document/displayname"
        },
        {
          "name": "chunk_size",
          "source": "/document/chunksize"
        },
        {
          "name": "chunk_overlap",
          "source": "/document/chunkoverlap"
        },
        {
          "name": "image_analysis",
          "source": "/document/imageanalysis"
        }
      ],
      "outputs": [
        {
          "name": "pages",
          "targetName": "pages"
        }
      ]
    },
    {
      "@odata.type": "#Microsoft.Skills.Text.AzureOpenAIEmbeddingSkill",
      "name": "#text-2",
      "description": null,
      "context": "/document/pages/*",
      "resourceUri": "${openai_endpoint}",
      "apiKey": "${openai_key}",
      "deploymentId": "embedding-002",
      "dimensions": 1536,
      "modelName": "text-embedding-ada-002",
      "inputs": [
        {
          "name": "text",
          "source": "/document/pages/*/text"
        }
      ],
      "outputs": [
        {
          "name": "embedding",
          "targetName": "text_vector"
        }
      ],
      "authIdentity": null
    }
  ],
  "cognitiveServices": null,
  "knowledgeStore": null,
  "indexProjections": {
    "selectors": [
      {
        "targetIndexName": "${contractid}",
        "parentKeyFieldName": "parent_id",
        "sourceContext": "/document/pages/*",
        "mappings": [
          {
            "name": "text_vector",
            "source": "/document/pages/*/text_vector",
            "sourceContext": null,
            "inputs": []
          },
          {
            "name": "chunk",
            "source": "/document/pages/*/text",
            "sourceContext": null,
            "inputs": []
          },
          {
            "name": "metadata_storage_path",
            "source": "/document/metadata_storage_path",
            "sourceContext": null,
            "inputs": []
          },
          {
            "name": "title",
            "source": "/document/title",
            "sourceContext": null,
            "inputs": []
          },
          {
            "name": "filtertag",
            "source": "/document/filtertag",
            "sourceContext": null,
            "inputs": []
          },
          {
            "name": "recordid",
            "source": "/document/recordid",
            "sourceContext": null,
            "inputs": []
          },
          {
            "name": "displayname",
            "source": "/document/displayname",
            "sourceContext": null,
            "inputs": []
          },
          {
            "name": "modifiedby",
            "source": "/document/modifiedby",
            "sourceContext": null,
            "inputs": []
          },
          {
            "name": "page_number",
            "source": "/document/pages/*/page_number",
            "sourceContext": null,
            "inputs": []
          }
        ]
      }
    ],
    "parameters": {
      "projectionMode": "skipIndexingParentDocuments"
    }
  },
  "encryptionKey": null
}
